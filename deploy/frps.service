[Unit]
Description=FRP server for GD32H757 demo
After=network-online.target
Wants=network-online.target

[Service]
User=frps
Group=frps
ExecStartPre=/opt/frp/frps verify -c /etc/frp/frps.toml
ExecStart=/opt/frp/frps -c /etc/frp/frps.toml
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
